# Dominio público del sitio, sin barra final. Se usa en sitemap.xml, robots.txt, canonical y Open Graph.
NEXT_PUBLIC_SITE_URL=https://dr-pietro-vittorini.vercel.app

# ID de medición de Google Analytics 4 (G-XXXXXXXXXX). Si está vacío, GA4 no se carga.
NEXT_PUBLIC_GA_ID=

# Código de verificación de Google Search Console (método "Etiqueta HTML": solo el valor de content). Vacío = no se agrega.
NEXT_PUBLIC_GSC_VERIFICATION=
